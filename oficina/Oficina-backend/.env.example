# =====================================================================
# .env.example — MODELO (este arquivo PODE ir para o Git)
# ---------------------------------------------------------------------
# Copie este arquivo para '.env' e preencha com os seus valores.
# O '.env' de verdade e IGNORADO pelo Git (.gitignore), entao suas
# senhas nunca sao publicadas. Este '.env.example' so mostra QUAIS
# variaveis existem, com valores de exemplo.
#
#   cp .env.example .env     <- comando para copiar
# =====================================================================

# Host do MySQL (na maioria dos casos e 'localhost' em desenvolvimento)
DB_HOST=localhost

# Usuario do MySQL
DB_USER=root

# Senha do MySQL (deixe vazio se nao tiver senha)
DB_PASSWORD=

# Nome do banco de dados (criado pelo banco.sql)
DB_NAME=oficina

# Porta onde o servidor sobe
PORT=3000

# Segredo para assinar os tokens JWT (IMPORTANTE: use um texto longo e
# aleatorio, NUNCA use o mesmo de exemplo em producao).
# Gere um seu com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-por-um-segredo-seu-bem-longo-e-aleatorio

# Tempo de vida do token (em segundos). 8h = 28800
JWT_EXPIRA_EM=28800
